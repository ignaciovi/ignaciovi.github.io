---
// Section heading: a small numbered label, a big title, and a hand-drawn squiggle underline.
import type { Accent } from '../data';

interface Props {
	title: string;
	index: string; // e.g. "01"
	accent?: Accent;
	kicker?: string;
}

const { title, index, accent = 'blue', kicker } = Astro.props;
---

<header class="sh" style={`--a: var(--c-${accent})`}>
	<p class="kicker"><span class="num">{index}</span>{kicker}</p>
	<h2>
		{title}
		<svg class="squiggle" viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true">
			<path d="M2 9 C 20 2, 35 13, 55 7 S 90 2, 110 8 S 150 13, 170 6 S 192 5, 198 8" />
		</svg>
	</h2>
</header>

<style>
	.sh {
		margin-bottom: 2.25rem;
	}
	.kicker {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}
	.num {
		display: inline-grid;
		place-items: center;
		min-width: 2.1rem;
		height: 2.1rem;
		padding-inline: 0.3rem;
		border-radius: 10px;
		background: var(--a);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0;
		rotate: -6deg;
	}
	h2 {
		position: relative;
		display: inline-block;
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
	}
	.squiggle {
		position: absolute;
		left: 0;
		bottom: -0.35em;
		width: 100%;
		height: 0.4em;
		overflow: visible;
	}
	.squiggle path {
		fill: none;
		stroke: var(--a);
		stroke-width: 4;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}
</style>
